# .env.example — Template per configurazione HPC (COMITTABILE)
# Copia in .env e compila con i TUOI valori (NON committare .env — è in .gitignore)
#
# Uso:
#   cp .env.example .env
#   # modifica .env con il tuo editor
#   source .env && ./hpc/hpc_connect.sh check

# === Obbligatori ===
HPC_USER=your_polito_username        # Il tuo username PoliTO (es. s123456, mrossi, ...)
HPC_HOST=polito-hpc                  # Alias SSH definito in ~/.ssh/config (default: polito-hpc)

# === Opzionali (hanno default sensati) ===
PROJECT_DIR_REMOTE='$HOME/am01_project'  # Path remoto dove fare deploy (il $HOME viene espanso lato remoto)

# === Solo se NON usi chiave SSH (sconsigliato) ===
# SSH_PASSWORD=your_polito_password    # Richiede 'sshpass' installato localmente